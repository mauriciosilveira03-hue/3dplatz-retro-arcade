
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090b13">
<title>3D PLATZ - Player</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090b13;color:white;font-family:Arial,sans-serif}
header{text-align:center;padding:20px;border-bottom:1px solid #252a39}
.logo{font-size:25px;font-weight:900;letter-spacing:2px}
.logo span{color:#00e5a0}
main{max-width:950px;margin:auto;padding:22px}
h1{font-size:25px}
p{color:#aab2c2;line-height:1.6}
#game{width:100%;height:65vh;min-height:350px;background:#151a28;border-radius:12px;overflow:hidden}
.notice{padding:16px;background:#151a28;border:1px solid #30394b;border-radius:10px;margin:18px 0}
a{color:#00e5a0}
</style>
</head>
<body>
<header>
<div class="logo">3D <span>PLATZ</span></div>
</header>
<main>
<p>RETRO GAMING EXPERIENCE</p>
<h1 id="title">Carregando...</h1>
<div class="notice" id="message">Preparando seu videogame virtual.</div>
<div id="game"></div>
<p>Seu progresso fica armazenado neste navegador. Não limpe os dados do site se quiser preservar seus saves.</p>
<p><a href="/">← Voltar ao 3D PLATZ</a></p>
</main>
<script>
const games = {
 pokemon: {
  name: "Pokemon GBA",
  rom: "",
  id: 101
 }
};

const params = new URLSearchParams(location.search);
const key = params.get("game");
const selected = games[key];

if (!selected) {
 document.getElementById("title").textContent = "Jogo não encontrado";
 document.getElementById("message").textContent = "Confira o endereço do seu chaveiro NFC.";
} else {
 document.getElementById("title").textContent = selected.name;
 document.getElementById("message").textContent =
 "Jogo cadastrado! Falta adicionar o arquivo ROM autorizado para iniciar.";
}
</script>
</body>
</html>
