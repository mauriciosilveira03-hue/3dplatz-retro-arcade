<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#090b13">
<title>3D PLATZ - Player</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090b13;color:white;font-family:Arial,sans-serif}
header{padding:20px;text-align:center;border-bottom:1px solid #252a39}
.logo{font-size:25px;font-weight:900;letter-spacing:2px}
.logo span{color:#00e5a0}
main{max-width:950px;margin:auto;padding:22px}
h1{font-size:25px}
p{color:#aab2c2;line-height:1.6}
#game{width:100%;height:65vh;min-height:350px;background:#151a28;border-radius:12px;overflow:hidden}
.notice{padding:16px;background:#151a28;border:1px solid #30394b;border-radius:10px;margin:18px 0}
a{color:#00e5a0}
</style>
</head>
<body>
<header>
<div class="logo">3D <span>PLATZ</span></div>
</header>
<main>
<div id="intro">
<p>RETRO GAMING EXPERIENCE</p>
<h1 id="title">Carregando jogo...</h1>
<div class="notice" id="message">
Preparando seu videogame virtual.
</div>
</div>
<div id="game"></div>
<p>Seu progresso fica armazenado neste navegador. Não limpe os dados do site se quiser preservar seus saves.</p>
<p><a href="/">← Voltar ao 3D PLATZ</a></p>
</main>
<script>
const games = {
  pokemon: {
    name: "Pokemon GBA",
    rom: "",
    id: 101
  }
};

const params = new URLSearchParams(location.search);
const gameKey = params.get("game");
const selected = games[gameKey];

if (!selected) {
  document.getElementById("title").textContent = "Jogo não encontrado";
  document.getElementById("message").textContent =
    "Confira o endereço do seu chaveiro NFC.";
} else if (!selected.rom) {
  document.getElementById("title").textContent = selected.name;
  document.getElementById("message").textContent =
    "Jogo cadastrado! Falta configurar o arquivo ROM autorizado para iniciar.";
} else {
  document.getElementById("title").textContent = selected.name;
  document.getElementById("message").textContent =
    "Carregando seu jogo. Aguarde...";

  window.EJS_player = "#game";
  window.EJS_core = "gba";
  window.EJS_gameUrl = selected.rom;
  window.EJS_gameName = "3DPLATZ_" + gameKey;
  window.EJS_gameID = selected.id;
  window.EJS_pathtodata =
    "https://cdn.emulatorjs.org/stable/data/";
  window.EJS_startOnLoaded = true;
  window.EJS_color = "#00e5a0";

  window.EJS_ready = function() {
    document.getElementById("message").textContent =
      "Emulador pronto! Divirta-se!";
  };

  const loader = document.createElement("script");
  loader.src = window.EJS_pathtodata + "loader.js";
  document.body.appendChild(loader);
}
</script>
</body>
</html>
